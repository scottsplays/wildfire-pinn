# Copy to a local .env and replace the value. Do not commit the filled file.
# The service reads the process environment. It does not read this file by itself.
WILDFIREPINN_API_KEY=replace-with-a-long-random-string

# Local and Cloud Run leave this unset (api_key). The key above is required.
# Vertex serving may set vertex_iam and omit the key. /predict then uses platform IAM.
# /models and /forecast stay closed until the key has at least 16 characters.
# WILDFIREPINN_PREDICT_AUTH=api_key

# Optional. When unset, forecast responses leave mask_artifact null.
# WILDFIREPINN_MASK_DIR=

# Optional. Set to 1 to expose /docs and /openapi.json on a private machine.
# WILDFIREPINN_ENABLE_DOCS=
